{
  "private": true,
  "workspaces": [
    "gridmix",
    "playground",
    "packages/*",
    "projects/*"
  ],
  "scripts": {
    "test:unit": "GRIDMIX_TEST=unit jest --runInBand",
    "test:e2e": "GRIDMIX_TEST=e2e jest --runInBand",
    "lint": "eslint \"@(gridmix|packages)/**/*.js\"",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "babel-eslint": "^10.0.1",
    "cheerio": "^1.0.0-rc.2",
    "eslint": "^5.2.0",
    "eslint-plugin-import": "^2.17.3",
    "eslint-plugin-node": "^7.0.1",
    "eslint-plugin-vue": "^9.3.0",
    "eslint-plugin-vue-libs": "^3.0.0",
    "execa": "^6.0.0",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "minimist": "^1.2.0",
    "puppeteer": "^13.1.3",
    "supertest": "^6.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.2.2"
}
